{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Syno Perm Manager",
  "version": "1.0.0",
  "identifier": "com.aclass.synoperm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Syno Perm Manager",
        "width": 1100,
        "height": 750,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright (c) 2026 Aclass Internet y Comunicaciones, S.L. - CC BY-NC-SA 4.0",
    "category": "Utility",
    "shortDescription": "Gestor de permisos ACL para Synology NAS",
    "longDescription": "Aplica permisos a multiples carpetas simultaneamente, analiza accesos por usuario, gestiona usuarios y grupos, y audita cambios via SSH.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": true,
        "compression": "lzma"
      }
    }
  }
}
